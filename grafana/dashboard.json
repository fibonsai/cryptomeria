{
  "title": "Cryptomeria - LOB Depth & Market Data",
  "uid": "cryptomeria-lob",
  "schemaVersion": 38,
  "version": 1,
  "panels": [
    {
      "id": 1,
      "title": "LOB Depth (Bids & Asks) — top levels by show-top-pct",
      "type": "timeseries",
      "datasource": "${DS_INFINITY}",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "lineWidth": 0,
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "Volume",
            "axisPlacement": "auto",
            "barAlignment": 0
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "ask"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "red",
                  "mode": "fixed"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "bid"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "green",
                  "mode": "fixed"
                }
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "type": "json",
          "format": "table",
          "root": "$.depth",
          "columns": [
            {"selector": "price", "text": "price", "type": "number"},
            {"selector": "volume", "text": "volume", "type": "number"},
            {"selector": "side", "text": "side", "type": "string"}
          ]
        }
      ]
    },
    {
      "id": 2,
      "title": "Best Bid",
      "type": "stat",
      "datasource": "${DS_INFINITY}",
      "gridPos": {
        "h": 4,
        "w": 8,
        "x": 0,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed"
          }
        }
      },
      "targets": [
        {
          "refId": "A",
          "type": "json",
          "format": "table",
          "root": "$",
          "columns": [
            {"selector": "best_bid", "text": "Best Bid", "type": "number"}
          ]
        }
      ]
    },
    {
      "id": 3,
      "title": "Best Ask",
      "type": "stat",
      "datasource": "${DS_INFINITY}",
      "gridPos": {
        "h": 4,
        "w": 8,
        "x": 8,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed"
          }
        }
      },
      "targets": [
        {
          "refId": "A",
          "type": "json",
          "format": "table",
          "root": "$",
          "columns": [
            {"selector": "best_ask", "text": "Best Ask", "type": "number"}
          ]
        }
      ]
    },
    {
      "id": 4,
      "title": "Last Update",
      "type": "stat",
      "datasource": "${DS_INFINITY}",
      "gridPos": {
        "h": 4,
        "w": 8,
        "x": 16,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "dateTimeAsIso",
          "color": {
            "mode": "fixed"
          }
        }
      },
      "targets": [
        {
          "refId": "A",
          "type": "json",
          "format": "table",
          "root": "$",
          "columns": [
            {"selector": "last_update_timestamp", "text": "Last Update", "type": "number"}
          ]
        }
      ]
    },
    {
      "id": 5,
      "title": "Spread",
      "type": "gauge",
      "datasource": "${DS_INFINITY}",
      "gridPos": {
        "h": 6,
        "w": 12,
        "x": 0,
        "y": 12
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "displayMode": "gradient"
          },
          "min": 0
        }
      },
      "targets": [
        {
          "refId": "A",
          "type": "json",
          "format": "table",
          "root": "$",
          "columns": [
            {"selector": "last_spread", "text": "Spread", "type": "number"}
          ]
        }
      ]
    },
    {
      "id": 6,
      "title": "Trades Per Second",
      "type": "gauge",
      "datasource": "${DS_INFINITY}",
      "gridPos": {
        "h": 6,
        "w": 12,
        "x": 12,
        "y": 12
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "displayMode": "gradient"
          },
          "min": 0
        }
      },
      "targets": [
        {
          "refId": "A",
          "type": "json",
          "format": "table",
          "root": "$",
          "columns": [
            {"selector": "trades_per_second", "text": "Trades/sec", "type": "number"}
          ]
        }
      ]
    }
  ],
  "templating": {
    "list": [
      {
        "name": "DS_INFINITY",
        "type": "datasource",
        "query": "yesoreyeram-infinity-datasource",
        "description": "Infinity datasource with JSON parser scraping the Rust /metrics endpoint"
      }
    ]
  }
}
